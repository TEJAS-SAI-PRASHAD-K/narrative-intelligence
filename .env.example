# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
# Every key below is OPTIONAL: the pipeline degrades gracefully and skips the
# sources whose credentials are absent, with a warning. Nothing hard-fails.

# --- Mastodon -------------------------------------------------------------
# Register an app once against a large public instance, e.g.:
#   python -m ingest.cli mastodon-register --instance https://mastodon.social
# That prints the access token to paste here. Read-only scope is enough.
MASTODON_API_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- YouTube Data API v3 --------------------------------------------------
# API key only (public read); no OAuth needed. Quota: 10,000 units/UTC day.
YOUTUBE_API_KEY=
# Hard budget for search.list calls (100 units each). 20 => 2,000 units/day.
YOUTUBE_MAX_SEARCHES_PER_DAY=20
YOUTUBE_DAILY_QUOTA_UNITS=10000

# --- NewsAPI (OPTIONAL; pipeline falls back to RSS-only without it) -------
# Free tier: ~100 req/day, results delayed ~24h, dev/non-commercial licence.
NEWSAPI_KEY=

# --- GDELT ----------------------------------------------------------------
# No credentials required. These just bound the pull.
GDELT_MAX_RECORDS=250
GDELT_LOOKBACK_DAYS=7

# --- Kaggle ---------------------------------------------------------------
# Preferred: place credentials at ~/.kaggle/kaggle.json (chmod 600).
# These env vars are an alternative the kaggle CLI also understands.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Paths / behaviour ----------------------------------------------------
DATA_DIR=data
USER_AGENT=narrative-intelligence-research/0.1 (academic capstone; contact: you@example.edu)
LOG_LEVEL=INFO
# Global politeness knob for outbound HTTP (requests per second).
HTTP_RATE_LIMIT_PER_SEC=2.0
