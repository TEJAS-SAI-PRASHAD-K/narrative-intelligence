# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
# Every key below is OPTIONAL: the pipeline degrades gracefully and skips the
# sources whose credentials are absent, with a warning. Nothing hard-fails.

# --- Mastodon -------------------------------------------------------------
# Register an app once against a large public instance, e.g.:
#   python -m ingest.cli mastodon-register --instance https://mastodon.social
# That prints the access token to paste here. Read-only scope is enough.
MASTODON_API_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- YouTube Data API v3 --------------------------------------------------
# API key only (public read); no OAuth needed. Quota: 10,000 units/UTC day.
YOUTUBE_API_KEY=
# Hard budget for search.list calls (100 units each). 20 => 2,000 units/day.
YOUTUBE_MAX_SEARCHES_PER_DAY=20
YOUTUBE_DAILY_QUOTA_UNITS=10000

# --- NewsAPI (OPTIONAL; pipeline falls back to RSS-only without it) -------
# Free tier: ~100 req/day, results delayed ~24h, dev/non-commercial licence.
NEWSAPI_KEY=

# --- GDELT ----------------------------------------------------------------
# No credentials required. These just bound the pull.
GDELT_MAX_RECORDS=250
GDELT_LOOKBACK_DAYS=7

# --- Kaggle ---------------------------------------------------------------
# Preferred: place credentials at ~/.kaggle/kaggle.json (chmod 600).
# These env vars are an alternative the kaggle CLI also understands.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Paths / behaviour ----------------------------------------------------
DATA_DIR=data
USER_AGENT=narrative-intelligence-research/0.1 (academic capstone; contact: you@example.edu)
LOG_LEVEL=INFO
# Global politeness knob for outbound HTTP (requests per second).
HTTP_RATE_LIMIT_PER_SEC=2.0

# ===========================================================================
# PHASE 4 -- BACKEND, PERSISTENCE & API
# ===========================================================================
# Everything below is read by app/config.py. The stack is strictly 12-factor:
# nothing here has a hardcoded host in the application code, and this file is
# the ONLY place a hostname is allowed to appear as a default.

# --- Datastores -----------------------------------------------------------
# In docker compose these are overridden with the service names (db, redis).
# The values below are what you want when running uvicorn directly on the host
# against `make up-deps`.
DATABASE_URL=postgresql+psycopg://narrative:changeme@localhost:5432/narrative
REDIS_URL=redis://localhost:6379/0
# Optional: only set if the sync driver must differ from the async one (e.g. a
# deployment that switches the request path to asyncpg). Defaults to the above.
DATABASE_URL_SYNC=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=30000

# --- Compose-only: how the db container initialises itself ----------------
POSTGRES_USER=narrative
POSTGRES_PASSWORD=changeme
POSTGRES_DB=narrative
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
API_WORKERS=1

# --- Auth -----------------------------------------------------------------
# Server-side pepper mixed into every API key hash. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates every issued key. That is the intended emergency lever.
API_KEY_PEPPER=
# Minted once by `make seed` if the api_keys table is empty, then never read
# again. Leave blank in production and issue keys through POST /api/v1/keys.
BOOTSTRAP_ADMIN_KEY=
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=60
# Comma-separated. The Phase 5 dashboard's dev server.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Behaviour ------------------------------------------------------------
ENVIRONMENT=local
# 1 = every route answers from app/mock instead of the database. This is what
# lets the Phase 5 dashboard be built against the contract before any data is
# loaded. Never 1 in production.
DEMO_MODE=0

# --- Embeddings -----------------------------------------------------------
# pgvector columns are fixed-width, so these two pin the deployment together.
# Changing EMBEDDING_DIM requires a migration, not a restart: see
# docs/data-model.md. MiniLM is 384; BAAI/bge-base-en-v1.5 is 768.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=64

# --- Model checkpoints ----------------------------------------------------
# Resolved as MODELS_DIR/<module>/<version>/ and mounted read-only into the
# containers. A missing checkpoint marks that scorer `unavailable` in /readyz
# and 503s only the routes that need it. It never stops the service booting.
MODELS_DIR=models
DATA_DIR=data
UPLOADS_DIR=uploads
REPORTS_DIR=reports

# --- Graph ----------------------------------------------------------------
# Hard server-side ceiling on /network/graph. Exceeding it truncates by
# descending node degree and reports `truncated: true` -- never silently.
MAX_GRAPH_NODES=20000
GRAPH_BUCKET_HOURS=12
LAYOUT_THRESHOLD_NODES=1000

# --- Media ----------------------------------------------------------------
MEDIA_MAX_BYTES=104857600
# Uploaded media is imagery of real people. Indefinite retention in a research
# project is not defensible; a beat task purges past this window. See README.
MEDIA_RETENTION_HOURS=24

# --- LLM (narrative summaries + Compass Context) --------------------------
# Optional. Without it, narrative labels fall back to centroid keywords and
# Compass Context is unavailable rather than ungrounded.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
COMPASS_PROMPT_VERSION=v1
COMPASS_MAX_RETRIES=2

# --- Inference threading --------------------------------------------------
# On macOS, torch and xgboost each bundle an OpenMP runtime and the two conflict:
# inference dies mid-batch with no traceback. Serialising OpenMP avoids it. The
# Makefile exports this for host-side commands; set it here for anything that
# runs the modeling code outside make (a bare `celery worker`, a notebook).
# Harmless on Linux, where there is only one OpenMP runtime.
OMP_NUM_THREADS=1

# --- Celery ---------------------------------------------------------------
# Split the queues across worker replicas so a 40-minute deepfake job cannot
# starve 15-minute alert evaluation.
CELERY_QUEUES=io,cpu,gpu,llm
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=info
